# Local development defaults only. Never reuse these values in a deployed service.
# PostGIS database and role used by the optional data Compose profile.
POSTGRES_DB=commencys
POSTGRES_USER=commencys
POSTGRES_PASSWORD=commencys-local-only

# Local Keycloak administrator; change before exposing any development service.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=commencys-local-admin-only

# Keep routing extracts outside the repository. Windows users may use D:/... here.
OSRM_DATA_DIR=./.local/osrm/java

# OSM standard raster tiles are for interactive development only. Keep attribution visible
# in the map UI and honor the OSM tile service usage policy before any production use.
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors

# Local service endpoints consumed by integration code when those adapters are implemented.
API_BASE_URL=http://localhost:8000
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=commencys
KEYCLOAK_CLIENT_ID=commencys-mobile
OSRM_BASE_URL=http://localhost:5000
