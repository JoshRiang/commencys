<?xml version="1.0" encoding="utf-8"?>
<!-- Widget relawan ringkas; bukan dashboard dan tidak memuat tugas contoh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/commencys_widget_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Judul membedakan widget tindakan relawan dari pintasan laporan pelapor. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/volunteer_widget_title"
        android:textColor="#202522"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Konten tugas diisi dari feed terautentikasi setelah layanan tersedia. -->
    <TextView
        android:id="@+id/volunteer_widget_task_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:text="@string/volunteer_widget_description"
        android:textColor="#667069"
        android:textSize="12sp" />

    <!-- Keputusan harus berasal dari relawan; kontrol belum dapat menjalankan tindakan. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/volunteer_widget_accept"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/volunteer_widget_accept"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <Button
            android:id="@+id/volunteer_widget_reject"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/volunteer_widget_reject"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
