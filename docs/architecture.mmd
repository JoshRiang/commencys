%% Current source boundaries. Dotted links are intended interfaces, not active flows.
flowchart LR
    subgraph Reporter["Reporter surface"]
        Citizen[Citizen / reporter] --> Widget[Android reporter widget: report / SOS]
        Widget -. disabled handoff .-> Mobile[Flutter report-flow shell]
    end

    subgraph Volunteer["Volunteer surface"]
        Responder[Volunteer] --> TaskWidget[Android task widget: view / accept / reject]
    end

    subgraph AdminSurface["Admin surface"]
        Admin[Admin] --> Dashboard[Static admin dashboard]
    end

    subgraph Api["API boundary"]
        API[FastAPI scaffold]
        Health[Health: scaffold, ready false]
        Payload[Raw JSON object payloads]
        Operations[Operational route declarations]
        API --> Health
        API --> Payload
        API -. HTTP 501 .-> Operations
    end

    subgraph Deferred["Imported service seams"]
        Store[StateStore interface; inactive]
        Laya[laya package imported; no router or weights]
        DBSCAN[scikit-learn DBSCAN imported; no fit or clustering]
    end

    Mobile -. future REST / WebSocket calls .-> API
    TaskWidget -. future task feed and decision calls .-> API
    Dashboard -. future API calls .-> API
    API -->|serves static assets| Dashboard
    AI[ai_pipeline.py] --> Laya
    AI --> DBSCAN
